<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ScsFileBrowser.AvaloniaUI.Views.Dialogs.TextInputDialog"
        Title="ScsFileBrowser"
        Icon="/Assets/logo.ico"
        Width="380"
        SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
  <StackPanel Margin="16" Spacing="10">
    <TextBlock x:Name="LabelText" TextWrapping="Wrap" />
    <TextBox x:Name="InputBox" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,6,0,0">
      <Button x:Name="CancelButton" Content="Cancel" MinWidth="80" HorizontalContentAlignment="Center" IsCancel="True" />
      <Button x:Name="ContinueButton" Content="Continue" MinWidth="80" HorizontalContentAlignment="Center" IsDefault="True" />
    </StackPanel>
  </StackPanel>
</Window>
